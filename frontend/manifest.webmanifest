{
  "name": "JobFinder.ma",
  "short_name": "JobFinder",
  "description": "Jobs and internships in Morocco",
  "start_url": "/?source=app",
  "scope": "/",
  "display": "standalone",
  "background_color": "#fcf9f4",
  "theme_color": "#2e9e74",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Offers", "url": "/jobs.html", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Internships", "url": "/jobs.html?type=Stage,PFE", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Dashboard", "url": "/dashboard.html", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
