# Copy this file to .env and fill in your values. Every line is optional for a first local run.

# PostgreSQL connection string. Leave empty to use a local SQLite file (jobfinder.db).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobfinder

# Long random string used to sign login tokens:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Public address of the site (used in email links)
SITE_URL=http://localhost:8000

# Google Gemini — chatbot, CV, portfolio, cover letters, CV upload, mock interviews
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Google Sign-In — OAuth Web client ID (add http://localhost:8000 to "Authorized JavaScript origins")
GOOGLE_CLIENT_ID=

# Emails (verification, password reset, application updates). Without SMTP they are printed in the server console.
# Required for spontaneous applications. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_PASSWORD = an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=

# First admin account (created on first start)
ADMIN_EMAIL=admin@jobfinder.ma
ADMIN_PASSWORD=change-me-too


# Email shown on the privacy policy and terms pages (default: ADMIN_EMAIL)
CONTACT_EMAIL=

# New offers every day from Jooble's official API. Free key: https://jooble.org/api/about
# Without a key the offers from data/offers.csv stay as they are (nothing is closed automatically).
JOOBLE_API_KEY=
JOOBLE_HOST=jooble.org
JOOBLE_LOCATION=Maroc
JOOBLE_KEYWORDS=stage,PFE,junior,alternance,débutant
# Offers from job boards close after this many days (only while the daily refresh is on)
OFFER_MAX_DAYS=45
